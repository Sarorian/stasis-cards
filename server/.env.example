# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB connection string (MongoDB Atlas: Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/stasis-cards

# The shared password you and your partner use to log in
APP_PASSWORD=change-me

# Any long random string; used to sign login tokens
JWT_SECRET=replace-with-a-long-random-string

# Where the React site runs (comma-separated). Add your GitHub Pages URL when deployed.
CLIENT_ORIGIN=http://localhost:5173,https://YOUR-GITHUB-USERNAME.github.io

# Market prices and images (free key at https://tcgapi.dev) - covers Pokemon, One Piece, Riftbound
TCGAPI_KEY=

# Optional: free key from https://dev.pokemontcg.io raises Pokemon lookup limits
POKEMONTCG_API_KEY=

# Optional (paid subscription): PriceCharting token for graded-card prices (PSA/CGC/BGS)
PRICECHARTING_TOKEN=

PORT=4000
